# Discord application credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Register commands instantly in one test server. Omit for global commands.
DISCORD_GUILD_ID=

# Channel that receives the daily post
WOTD_CHANNEL_ID=

# Daily schedule
WOTD_POST_TIME=10:00
WOTD_TIMEZONE=Europe/Berlin

# Mount /app/data as persistent storage in production
DATABASE_PATH=./data/wotd.sqlite
